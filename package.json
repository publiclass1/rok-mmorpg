{
  "name": "rok-mmorpg",
  "version": "0.1.0",
  "private": true,
  "description": "ROK-MMORPG — browser MMORPG (Vite + Phaser + Express + MySQL)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev:all": "concurrently -n client,server -c blue,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client && npm run build -w server",
    "lint": "npm run lint -w client",
    "preview": "npm run preview -w client",
    "content:validate": "npm run content:validate -w client",
    "content:sync-mob-spots": "node scripts/sync-mob-spots-to-server.mjs",
    "content:sync-items": "node scripts/sync-items-to-server.mjs",
    "content:sync-items:check": "node scripts/sync-items-to-server.mjs --check",
    "icons:weapons": "node scripts/generate-weapon-icons.mjs",
    "icons:weapons:check": "node scripts/generate-weapon-icons.mjs --check",
    "icons:gear": "node scripts/generate-gear-icons.mjs",
    "icons:gear:check": "node scripts/generate-gear-icons.mjs --check",
    "icons:skills": "node scripts/generate-skill-icons.mjs",
    "icons:skills:check": "node scripts/generate-skill-icons.mjs --check",
    "icons": "npm run icons:weapons && npm run icons:gear && npm run icons:skills",
    "maps:prontera": "node scripts/generate-prontera-map.mjs",
    "maps:culvert": "node scripts/generate-culvert-map.mjs",
    "maps:prt-fild01": "node scripts/generate-prt-fild01-map.mjs",
    "maps:dungeons": "node scripts/generate-dungeon-maps.mjs",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
